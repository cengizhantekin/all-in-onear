(module
  (import "env" "storage_write" (func $write (param i64 i64 i64 i64 i64) (result i64)))
  (import "env" "storage_read" (func $read (param i64 i64 i64) (result i64)))
  (import "env" "read_register" (func $register (param i64 i64)))
  (import "env" "register_len" (func $length (param i64) (result i64)))
  (import "env" "value_return" (func $return (param i64 i64)))
  (memory (export "memory") 1)
  (data (i32.const 0) "last")
  (data (i32.const 16) "\22allowed\22")
  (data (i32.const 32) "\22blocked\22")
  (data (i32.const 48) "\22none\22")
  (func (export "allowed")
    (drop (call $write (i64.const 4) (i64.const 0) (i64.const 9) (i64.const 16) (i64.const 1)))
    (call $return (i64.const 9) (i64.const 16)))
  (func (export "blocked")
    (drop (call $write (i64.const 4) (i64.const 0) (i64.const 9) (i64.const 32) (i64.const 1)))
    (call $return (i64.const 9) (i64.const 32)))
  (func (export "get_last")
    (if (i64.eqz (call $read (i64.const 4) (i64.const 0) (i64.const 0)))
      (then (call $return (i64.const 6) (i64.const 48)))
      (else
        (call $register (i64.const 0) (i64.const 64))
        (call $return (call $length (i64.const 0)) (i64.const 64)))))
)
